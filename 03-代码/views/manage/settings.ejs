<%- include('partials/shell-top', { settings, pageTitle: '系统设置 · 后台管理', nav, user, fmtLocal, serverNowIso, flash }) %>

<div class="main-head">
  <div>
    <h1>系统设置</h1>
    <div class="sub">修改计分规则或权重后，系统会立即按新规则重新计算全部排名。</div>
  </div>
</div>

<form method="post" action="/manage/settings/save" data-ajax data-refresh="#settingsForm">
  <input type="hidden" name="__settings_form" value="1" />
  <div class="grid cols-2" id="settingsForm">
    <div class="card">
      <div class="card-title"><h3>赛事信息</h3></div>
      <div class="field">
        <label>赛事名称</label>
        <input type="text" name="event_title" value="<%= settings.event_title %>" required />
      </div>
      <div class="field">
        <label>副标题</label>
        <input type="text" name="event_subtitle" value="<%= settings.event_subtitle || '' %>" />
      </div>
      <div class="field">
        <label>页脚提示文字</label>
        <input type="text" name="footer_note" value="<%= settings.footer_note || '' %>" placeholder="如：请输入工作人员发放的密码条进行投票" />
      </div>
      <div class="row" style="gap:14px">
        <div>
          <label>主色调</label>
          <input type="color" name="theme_color" value="<%= settings.theme_color %>" style="width:80px;padding:3px;height:40px" />
        </div>
        <div>
          <label>强调色</label>
          <input type="color" name="accent_color" value="<%= settings.accent_color %>" style="width:80px;padding:3px;height:40px" />
        </div>
      </div>
      <label class="checkline mt-2">
        <input type="checkbox" name="board_public" <%= settings.board_public === '1' ? 'checked' : '' %> />
        向公众开放排名公示榜（<code>/board</code>）
        <span class="hint" style="display:block">不勾选时，<b>任何人</b>（包括管理员）访问 /board 都会返回 403；管理员可用 <code>/manage/board</code> 预览</span>
      </label>
    </div>

    <div class="card">
      <div class="card-title"><h3>投票与打分规则</h3></div>
      <div class="form-grid">
        <div>
          <label>大众评审可勾选人数</label>
          <input type="number" name="public_pick_count" value="<%= settings.public_pick_count %>" min="1" max="20" required />
          <div class="hint">需求：3 位（不可多选）</div>
        </div>
        <div>
          <label>大众赋分·第 1 名分数</label>
          <input type="number" name="top_points" value="<%= settings.top_points %>" min="1" max="100" required />
          <div class="hint">第 2 名递减 1 分，依次类推</div>
        </div>
        <div>
          <label>零票选手赋分</label>
          <input type="number" name="zero_vote_points" value="<%= settings.zero_vote_points %>" min="0" max="50" />
        </div>
        <div>
          <label>专业评审席位数</label>
          <input type="number" name="judge_count" value="<%= settings.judge_count %>" min="1" max="20" required />
          <div class="hint">需求：4 位</div>
        </div>
      </div>
      <div class="field mt-2">
        <label>并列名次赋分规则</label>
        <select name="tie_rank_rule">
          <option value="best" <%= settings.tie_rank_rule === 'best' ? 'selected' : '' %>>并列取最优名次，后续名次跳过（两人并列第 2，下一名为第 4）</option>
          <option value="average" <%= settings.tie_rank_rule === 'average' ? 'selected' : '' %>>并列取平均名次</option>
        </select>
      </div>
      <div class="field">
        <label>专业评审缺评处理</label>
        <select name="missing_judge_rule">
          <option value="submitted" <%= settings.missing_judge_rule === 'submitted' ? 'selected' : '' %>>按实际提交评审人数求平均（缺评不计入分母）</option>
          <option value="all" <%= settings.missing_judge_rule === 'all' ? 'selected' : '' %>>缺评按 0 分计入，再除以评审总人数</option>
        </select>
      </div>
      <label class="checkline">
        <input type="checkbox" name="pro_can_edit" <%= settings.pro_can_edit === '1' ? 'checked' : '' %> />
        允许专业评审在截止前重复提交以修改分数
      </label>
    </div>

    <div class="card">
      <div class="card-title"><h3>计分与总成绩</h3></div>
      <div class="form-grid">
        <div>
          <label>小组赛权重</label>
          <input type="number" name="weight_group" value="<%= settings.weight_group %>" min="0" max="1" step="0.01" required />
          <div class="hint">需求：0.4</div>
        </div>
        <div>
          <label>个人赛权重</label>
          <input type="number" name="weight_individual" value="<%= settings.weight_individual %>" min="0" max="1" step="0.01" required />
          <div class="hint">需求：0.6</div>
        </div>
        <div>
          <label>赛事得分上限</label>
          <input type="number" name="score_cap" value="<%= settings.score_cap %>" min="1" max="500" required />
          <div class="hint">需求：110（100 + 10）</div>
        </div>
        <div>
          <label>小数位数</label>
          <input type="number" name="score_decimals" value="<%= settings.score_decimals %>" min="0" max="4" required />
        </div>
      </div>
      <div class="hint" style="margin-bottom:10px;color:<%= Math.abs(weightSum - 1) < 0.001 ? 'var(--muted)' : 'var(--err)' %>">
        当前权重之和 = <b><%= weightSum %></b><%= Math.abs(weightSum - 1) < 0.001 ? '（正确）' : '（通常应为 1，例如 0.4 + 0.6）' %>
      </div>
      <div class="field mt-2">
        <label>总成绩并列时的决胜规则</label>
        <select name="final_tie_break">
          <option value="individual" <%= settings.final_tie_break === 'individual' ? 'selected' : '' %>>个人赛得分高者优先</option>
          <option value="group" <%= settings.final_tie_break === 'group' ? 'selected' : '' %>>小组赛得分高者优先</option>
          <option value="pro_avg" <%= settings.final_tie_break === 'pro_avg' ? 'selected' : '' %>>专业评审平均分之和高者优先</option>
        </select>
      </div>
    </div>

    <div class="card">
      <div class="card-title"><h3>安全设置</h3></div>
      <div class="form-grid">
        <div>
          <label>后台连续失败几次锁定</label>
          <input type="number" name="admin_max_fails" value="<%= settings.admin_max_fails %>" min="1" max="50" required />
          <div class="hint">需求：5 次</div>
        </div>
        <div>
          <label>锁定时长（分钟）</label>
          <input type="number" name="admin_lock_minutes" value="<%= settings.admin_lock_minutes %>" min="1" max="1440" required />
          <div class="hint">需求：60 分钟</div>
        </div>
        <div>
          <label>登录会话有效期（小时）</label>
          <input type="number" name="session_hours" value="<%= settings.session_hours %>" min="1" max="720" required />
        </div>
        <div>
          <label>同一 IP 允许的登录次数</label>
          <input type="number" name="login_rate_max" value="<%= settings.login_rate_max %>" min="10" max="100000" required />
          <div class="hint">防暴力枚举密码条用</div>
        </div>
        <div>
          <label>限流窗口（分钟）</label>
          <input type="number" name="login_rate_window_minutes" value="<%= settings.login_rate_window_minutes %>" min="1" max="1440" required />
        </div>
      </div>
      <p class="tiny muted mt-2 mb-0">
        除账号锁定期制外，系统还会对同一 IP 的密码条登录尝试做宽松限流，用于防止暴力枚举密码条。
        <b>注意</b>：现场若大量用户共用同一校园网出口 IP，所有登录都算在同一个 IP 上；
        默认「每 5 分钟 2000 次」足以支撑数百人同时进场。若现场人数更多或出现"操作过于频繁"提示，
        可把这两个值调大（例如 20000 次 / 5 分钟）——密码条为 8 位、32 字符集，暴力破解本身不可行。
      </p>
    </div>
  </div>

  <div class="row end mt-2">
    <button class="btn btn-primary btn-lg" type="submit">保存全部设置并重算</button>
  </div>
</form>

<div class="grid cols-2 mt-3">
  <div class="card">
    <div class="card-title"><h3>修改我的密码</h3><span class="badge"><%= user.username %></span></div>
    <form method="post" action="/manage/settings/password" data-ajax data-reset-on-success="1" autocomplete="off">
      <div class="field">
        <label>当前密码</label>
        <input type="password" name="current" required />
      </div>
      <div class="form-grid">
        <div>
          <label>新密码</label>
          <input type="password" name="next" minlength="6" required />
        </div>
        <div>
          <label>确认新密码</label>
          <input type="password" name="confirm" minlength="6" required />
        </div>
      </div>
      <button class="btn btn-primary mt-2" type="submit">修改密码</button>
    </form>
  </div>

  <div class="card">
    <div class="card-title"><h3>新增管理员</h3></div>
    <form method="post" action="/manage/settings/admins/create" data-ajax data-refresh="#adminsList" data-reset-on-success="1" autocomplete="off">
      <div class="form-grid">
        <div>
          <label>账号</label>
          <input type="text" name="username" required />
        </div>
        <div>
          <label>密码（留空自动生成）</label>
          <input type="text" name="password" placeholder="至少 6 位" />
        </div>
      </div>
      <div class="field mt-2">
        <label>备注</label>
        <input type="text" name="note" placeholder="如：现场技术支持" />
      </div>
      <button class="btn btn-primary" type="submit">创建管理员</button>
    </form>
  </div>
</div>

<div class="card mt-2" id="adminsList">
  <div class="card-title"><h3>管理员账号</h3><span class="badge"><%= admins.length %> 个</span></div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>账号</th><th>状态</th><th>最后登录</th><th>备注</th><th>操作</th></tr></thead>
      <tbody>
        <% admins.forEach(function (a) { %>
          <% var locked = a.locked_until && new Date(a.locked_until).getTime() > now; %>
          <tr>
            <td>
              <b><%= a.username %></b>
              <% if (a.id === currentAdminId) { %><span class="badge badge-brand">当前登录</span><% } %>
            </td>
            <td>
              <% if (locked) { %>
                <span class="badge badge-err">已锁定至 <%= fmtLocal(a.locked_until, false) %></span>
              <% } else if (a.failed_count > 0) { %>
                <span class="badge badge-warn">失败 <%= a.failed_count %> 次</span>
              <% } else { %>
                <span class="badge badge-ok">正常</span>
              <% } %>
            </td>
            <td class="tiny muted"><%= a.last_login_at ? fmtLocal(a.last_login_at, false) : '从未登录' %></td>
            <td class="small muted"><%= a.note || '' %></td>
            <td>
              <div class="btn-group">
                <% if (locked || a.failed_count > 0) { %>
                  <form method="post" action="/manage/settings/admins/unlock" data-ajax data-refresh="#adminsList">
                    <input type="hidden" name="id" value="<%= a.id %>" />
                    <button class="btn btn-sm" type="submit">解锁</button>
                  </form>
                <% } %>
                <form method="post" action="/manage/settings/admins/password" data-ajax data-refresh="#adminsList" data-confirm="确认为「<%= a.username %>」设置新密码？" class="row" style="gap:5px">
                  <input type="hidden" name="id" value="<%= a.id %>" />
                  <input type="text" name="password" placeholder="新密码" minlength="6" required style="width:120px" />
                  <button class="btn btn-sm" type="submit">重置密码</button>
                </form>
                <% if (a.id !== currentAdminId && admins.length > 1) { %>
                  <form method="post" action="/manage/settings/admins/delete" data-ajax data-refresh="#adminsList" data-confirm="确认删除管理员「<%= a.username %>」？">
                    <input type="hidden" name="id" value="<%= a.id %>" />
                    <button class="btn btn-sm btn-danger" type="submit">删除</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/shell-bottom') %>
