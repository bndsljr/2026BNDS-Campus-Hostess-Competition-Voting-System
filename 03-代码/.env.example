# 2026 主持人大赛投票系统 —— 运行期环境变量
# 部署时复制为 /opt/hostvote/app/.env（不要提交真实密码到代码仓库）

# 应用监听（仅本机，外部经 Nginx 80 / 8080 访问）
HV_HOST=127.0.0.1
HV_PORT=3000

# 数据与日志目录（独立于代码，便于升级与备份）
HV_DATA_DIR=/opt/hostvote/data
HV_BACKUP_DIR=/opt/hostvote/backup
HV_LOG_DIR=/opt/hostvote/logs

# 数据库文件（默认 $HV_DATA_DIR/hostvote.db）
# HV_DB=/opt/hostvote/data/hostvote.db

# 首次启动时创建的管理员账号（仅首次生效，之后请在后台修改密码）
HV_ADMIN_USER=admin
HV_ADMIN_PASS=CHANGE_ME_BEFORE_FIRST_BOOT

# 首次启动时预生成的大众评审密码条数量（仅首次生效）
HV_SEED_PUBLIC_CODES=20

# 后台登录失败锁定（也可在后台「系统设置」中修改）
HV_ADMIN_MAX_FAILS=5
HV_ADMIN_LOCK_MINUTES=60

# 登录会话有效期（小时）
HV_SESSION_HOURS=12

# 上传的选手照片大小上限（字节，默认 8MB）
HV_MAX_UPLOAD=8388608

# 日志级别：trace/debug/info/warn/error
HV_LOG_LEVEL=info
