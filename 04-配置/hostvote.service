# /etc/systemd/system/hostvote.service
# 2026 主持人大赛投票系统 —— 进程守护（开机自启、崩溃自动重启）

[Unit]
Description=2026 Host Contest Voting System (hostvote)
Documentation=file:/opt/hostvote/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hostvote
Group=hostvote
WorkingDirectory=/opt/hostvote/app
EnvironmentFile=/opt/hostvote/app/.env
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM

# 日志（同时保留 journalctl -u hostvote）
StandardOutput=append:/opt/hostvote/logs/app.log
StandardError=append:/opt/hostvote/logs/app.err.log
SyslogIdentifier=hostvote

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/hostvote

[Install]
WantedBy=multi-user.target
